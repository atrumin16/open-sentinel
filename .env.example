# OpenSentinel Environment Variables Example
SERVER_NAME=OpenSentinel
PORT=8888
HOST=0.0.0.0
AUTO_ALERT_ON_BOOT=true

# Discord Configuration
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_THREAD_ID=

# Telegram Configuration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# WhatsApp Configuration (CallMeBot or Custom Webhook)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=+34600000000
WHATSAPP_API_KEY=YOUR_CALLMEBOT_APIKEY
WHATSAPP_WEBHOOK_URL=

# Feature Toggles
ENABLE_WEBCAM=true
ENABLE_SCREENSHOT=true
ENABLE_CMD_EXECUTION=true
